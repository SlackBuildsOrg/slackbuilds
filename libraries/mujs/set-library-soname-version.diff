--- Makefile.orig	2026-10-20 06:19:20.000000000 +1100
+++ Makefile	2026-11-27 18:50:25.553572978 +1100
@@ -2,7 +2,16 @@
 #
 # Useful targets are: release, install, uninstall.
 
+ifeq ($(shell uname),Darwin)
+  SO = dylib
+else
+  SO = so
+endif
+
 default: build/debug/mujs build/debug/mujs-pp
+shared: build/release/libmujs.$(SO)
+
+SO_VERSION=1
 
 CFLAGS = -std=c99 -pedantic -Wall -Wextra -Wno-unused-parameter
 
@@ -19,12 +28,6 @@
   VERSION = $(patsubst mujs-%,%,$(notdir $(CURDIR)))
 endif
 
-ifeq ($(shell uname),Darwin)
-  SO = dylib
-else
-  SO = so
-endif
-
 ifeq ($(shell uname),FreeBSD)
   CFLAGS += -I/usr/local/include -L/usr/local/lib
 endif
@@ -103,7 +106,8 @@
 
 build/release/libmujs.$(SO): one.c $(SRCS) $(HDRS)
 	@mkdir -p $(@D)
-	$(CC) $(CFLAGS) $(OPTIM) -fPIC -shared -o $@ one.c -lm
+	$(CC) $(CFLAGS) $(OPTIM) -fPIC -shared -Wl,-soname,libmujs.$(SO).$(SO_VERSION) -o $@.$(SO_VERSION) $< -lm
+	ln -sf libmujs.$(SO).$(SO_VERSION) $@
 build/release/libmujs.o: one.c $(SRCS) $(HDRS)
 	@mkdir -p $(@D)
 	$(CC) $(CFLAGS) $(OPTIM) -c -o $@ one.c
@@ -137,7 +141,9 @@
 	install -m 644 build/release/libmujs.a $(DESTDIR)$(libdir)
 
 install-shared: install-common build/release/libmujs.$(SO)
-	install -m 755 build/release/libmujs.$(SO) $(DESTDIR)$(libdir)
+	install -m 755 build/release/libmujs.$(SO).$(SO_VERSION) $(DESTDIR)$(libdir)
+	cp -af build/release/libmujs.$(SO) $(DESTDIR)$(libdir)
+	chmod 0755 $(DESTDIR)$(libdir)
 
 install: install-static
 
@@ -148,6 +154,7 @@
 	rm -f $(DESTDIR)$(libdir)/pkgconfig/mujs.pc
 	rm -f $(DESTDIR)$(libdir)/libmujs.a
 	rm -f $(DESTDIR)$(libdir)/libmujs.$(SO)
+	rm -f $(DESTDIR)$(libdir)/libmujs.$(SO).$(SO_VERSION)
 
 tarball:
 	git archive --format=zip --prefix=mujs-$(VERSION)/ HEAD > mujs-$(VERSION).zip
