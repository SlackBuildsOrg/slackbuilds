#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

# 20230627 bkw: Modified by SlackBuilds.org, BUILD=2:
# - get rid of libkrb5*.so symlinks; the app uses the ones in /usr/lib64.
# - fix a few typos in the README.
# - don't chown and chmod all of /tmp/SBo.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=letos
VERSION=${VERSION:-4.0.4}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

SQLITE_PKG=sqlite-3.50.4-x86_64-2_slack15.0

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

# Only x86_64 is supported (the sqlite package from patches is x86_64 only)
if [ "$ARCH" != "x86_64" ]; then
  echo "Unsupported architecture: $ARCH (only x86_64 is supported)."
  exit 1
fi

SLKCFLAGS="-O2 -fPIC"
LIBDIRSUFFIX="64"

set -e

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION

# Make sure sqlite from the official patches/packages is installed
if [ ! -e /var/lib/pkgtools/packages/$SQLITE_PKG ]; then
  /sbin/upgradepkg --install-new $CWD/$SQLITE_PKG.txz
fi

tar xvf $CWD/$PRGNAM-$VERSION.tar.gz
cd $PRGNAM-$VERSION

chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} + -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} +

# Qt6 from SlackBuilds.org lives in /usr/lib64/qt6
QT6DIR=${QT6DIR:-/usr/lib${LIBDIRSUFFIX}/qt6}
export PATH=$QT6DIR/bin:$PATH

# Common cmake options: FHS ("Unix favored") layout under /usr,
# no built-in update manager (the package manager handles updates).
CMAKE_OPTS=(
  -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS"
  -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS"
  -DCMAKE_INSTALL_PREFIX=/usr
  -DCMAKE_INSTALL_LIBDIR=lib${LIBDIRSUFFIX}
  -DCMAKE_PREFIX_PATH=$QT6DIR
  -DCMAKE_BUILD_TYPE=Release
  -DBUILD_TESTING=OFF
  -DWITH_UNIX_FAV=ON
  -DWITH_UPDATER=OFF
)

# build program
mkdir -p build/app
cd build/app
  cmake "${CMAKE_OPTS[@]}" ../../Letos
  cmake --build . -j $(nproc)
  DESTDIR=$PKG cmake --install .
cd ../..

# build plugins (the Python scripting plugin uses Slackware's python3)
mkdir -p build/plugins
cd build/plugins
  cmake "${CMAKE_OPTS[@]}" ../../Plugins
  cmake --build . -j $(nproc)
  DESTDIR=$PKG cmake --install .
cd ../..

# hicolor icons are installed as letos_NN.png, but the .desktop file
# uses Icon=letos, so rename them to letos.png
for icon in $PKG/usr/share/icons/hicolor/*/apps/letos_*.png; do
  if [ -e "$icon" ]; then
    mv "$icon" "$(dirname "$icon")/letos.png"
  fi
done

# remove any leftover rpath
find $PKG -type f -print0 | xargs -0 file | grep ELF | cut -f 1 -d : | \
  xargs -r chrpath -d 2> /dev/null || true

rm -f $PKG/{,usr/}lib${LIBDIRSUFFIX}/*.la

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a ChangeLog.md LICENSE README.md $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
