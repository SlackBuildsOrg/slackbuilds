cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=podman
VERSION=${VERSION:-6.2.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

set -e

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.gz --no-same-owner
cd $PRGNAM-$VERSION
find . ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

export PATH="/usr/lib${LIBDIRSUFFIX}/go/bin:$PATH"
export GOPATH="$TMP/go-$PRGNAM"
export CGO_CFLAGS="$SLKCFLAGS"
export CGO_LDFLAGS="$SLKCFLAGS"

BUILDTAGS="seccomp exclude_graphdriver_devicemapper containers_image_openpgp"

make \
  PREFIX=/usr \
  LIBDIR=/usr/lib${LIBDIRSUFFIX} \
  LIBEXECDIR=/usr/libexec \
  MANDIR=/usr/man \
  ETCDIR=/etc \
  BUILDTAGS="$BUILDTAGS" \
  binaries docs

make \
  PREFIX=/usr \
  LIBDIR=/usr/lib${LIBDIRSUFFIX} \
  LIBEXECDIR=/usr/libexec \
  MANDIR=/usr/man \
  ETCDIR=/etc \
  DESTDIR=$PKG \
  install.bin install.man install.completions

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

find $PKG/usr/man -type f -exec gzip -9 {} \;
for i in $( find $PKG/usr/man -type l ) ; do ln -s $( readlink $i ).gz $i.gz ; rm $i ; done

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a \
  CONTRIBUTING.md LICENSE MAINTAINERS.md README.md RELEASE_NOTES.md \
  $PKG/usr/doc/$PRGNAM-$VERSION 2>/dev/null || true
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

# Configuration helper documents
cat $CWD/cgroups2.patch > $PKG/usr/doc/$PRGNAM-$VERSION/cgroups2.patch
sed "s/@VERSION@/$VERSION/g" $CWD/set-cgroup-2.sh > $PKG/usr/doc/$PRGNAM-$VERSION/set-cgroup-2.sh
sed "s/@VERSION@/$VERSION/g" $CWD/README.Slackware > $PKG/usr/doc/$PRGNAM-$VERSION/README.Slackware

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

mkdir -p $PKG/etc/containers/secrets
cp $CWD/registries.conf $PKG/etc/containers/registries.conf.new
cp $CWD/mounts.conf $PKG/etc/containers/mounts.conf.new
cp $CWD/policy.json $PKG/etc/containers/policy.json.new
printf "[engine]\nhelper_binaries_dir = [\"/usr/bin\", \"/usr/libexec/podman\", \"/usr/lib/podman\"]\n" > $PKG/etc/containers/containers.conf.new
printf "unqualified-search-registries = [\"docker.io\"]\n" > $PKG/etc/containers/registries.conf.new

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
