#!/bin/bash

# Slackware build script for pis
# Copyright 2023-2026 Guilherme Esmeraldo - Crato/CE - Brazil
# All rights reserved.

cd "$(dirname "$0")" ; CWD="$(pwd)"

PRGNAM=pis
VERSION=${VERSION:-0.3.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}
ARCH=noarch

if [ -n "${PRINT_PACKAGE_NAME:-}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf "$PRGNAM-$VERSION"
tar xvf "$CWD/$PRGNAM-$VERSION.tar.gz" --no-same-owner
cd "$PRGNAM-$VERSION"
chown -R root:root .
find -L . \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \) -exec chmod 755 {} \+ -o \
         \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \+

mkdir -p "$PKG/sbin"
for script in pis pis_*; do
  [ "$script" = pis_lib ] && continue
  install -m 0755 "$script" "$PKG/sbin/$script"
done
install -m 0644 pis_lib "$PKG/sbin/pis_lib"

mkdir -p "$PKG/usr/man/man1"
gzip -9 -c manpage/pis.1 > "$PKG/usr/man/man1/pis.1.gz"

mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cp -a CHANGELOG LICENSE README.md doc/README "$PKG/usr/doc/$PRGNAM-$VERSION/"
cat $CWD/pis.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/pis.SlackBuild

mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"

cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
